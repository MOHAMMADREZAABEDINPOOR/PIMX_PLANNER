{
  "name": "pimxplanner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "cross-env PG_CONNECTION_STRING=postgres://postgres:12345678fgh@localhost:5433/planner PORT=4000 node server/index.cjs",
    "start": "concurrently \"npm run api\" \"npm run dev\"",
    "start:db": "scripts\\start-db.bat",
    "stop:db": "scripts\\stop-db.bat",
    "start:all": "npm run start:db && timeout /t 3 /nobreak > nul && npm run start"
  },
  "dependencies": {
    "@google/genai": "latest",
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "lucide-react": "^0.555.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.11.9",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
